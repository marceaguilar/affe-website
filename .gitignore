# Jekyll build output and local cache
_site/
.jekyll-cache/

# macOS folder metadata. The previous pattern only matched one level deep,
# so files such as assets/pdf/.DS_Store were still showing up as untracked.
.DS_Store

# Per-machine Claude Code permission grants. The shared launch config in
# .claude/launch.json is committed; this file is not.
.claude/settings.local.json
